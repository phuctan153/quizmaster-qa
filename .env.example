# Copy values into your process environment; do not commit real credentials.
# Docker Compose reads .env; Java started directly requires process environment.
DB_USERNAME=quizmaster
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/quizmaster
DB_PORT=5432
JWT_SECRET_BASE64=
# Required only for the explicit one-time bootstrap profile:
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
